{
  "name": "npu-inference-platform",
  "version": "1.0.0",
  "description": "Orange Pi 5 NPU Inference Platform - Tailwind CSS build",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./app/static/css/app.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./app/static/css/app.css --watch",
    "dev": "npx tailwindcss -i ./src/input.css -o ./app/static/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
