# =============================================================================
# NPU Inference Platform - Environment Configuration
# Copy this file to .env and modify as needed
# =============================================================================

# Application
APP_DEBUG=false
APP_APP_NAME=NPU Inference Platform
APP_APP_VERSION=1.0.0

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_LOG_LEVEL=info

# Camera
CAMERA_MAX_CAMERAS=8
CAMERA_RECONNECT_INTERVAL=5
CAMERA_FRAME_BUFFER_SIZE=1
CAMERA_DEFAULT_FPS_LIMIT=30
CAMERA_RTSP_TRANSPORT=tcp

# Inference (NPU)
INFERENCE_DEFAULT_CONFIDENCE=0.5
INFERENCE_DEFAULT_NMS_THRESHOLD=0.45
INFERENCE_DEFAULT_CORE_MASK=7
INFERENCE_MAX_LOADED_MODELS=3
INFERENCE_ENABLE_FRAME_SKIP=true

# Stream
STREAM_MJPEG_QUALITY=80
STREAM_MJPEG_MAX_FPS=30
STREAM_WS_MAX_FPS=30
STREAM_MAX_WS_CLIENTS=10

# Storage
STORAGE_MAX_SNAPSHOTS=1000
STORAGE_MAX_LOG_SIZE_MB=100
STORAGE_SNAPSHOT_QUALITY=95

# Notifications (MQTT)
NOTIFY_MQTT_ENABLED=false
NOTIFY_MQTT_BROKER=localhost
NOTIFY_MQTT_PORT=1883
NOTIFY_MQTT_TOPIC_PREFIX=npu-platform

# Notifications (Webhook)
NOTIFY_WEBHOOK_ENABLED=false
# NOTIFY_WEBHOOK_URL=https://your-webhook-url.com/hook

# Security
SECURITY_ENABLE_AUTH=false
SECURITY_MAX_UPLOAD_SIZE_MB=500
SECURITY_CORS_ORIGINS=["*"]
